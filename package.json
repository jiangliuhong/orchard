{
  "name": "@jarome/orchard",
  "version": "0.0.1",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "migration:check": "node scripts/check-migration-manifest.mjs --require-review && node scripts/generate-migration-bundle.mjs --check",
    "prebuild": "npm run migration:check && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "postbuild": "node scripts/create-migration-integrity.mjs",
    "predev": "npm run migration:check",
    "pretest": "npm run migration:check",
    "build": "tsc -p tsconfig.server.json && mkdir -p dist/web-bridge/extension && cp -R src/web-bridge/extension/. dist/web-bridge/extension && cp src/web-bridge/catalog.json dist/web-bridge/catalog.json && vite build",
    "start": "node dist/server/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "bin": {
    "orchard": "dist/cli/index.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.8",
    "@xyflow/react": "12.12.1",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "fastify": "5.12.8",
    "lucide-react": "1.67.0",
    "monaco-editor": "0.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.16",
    "smol-toml": "1.9.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
