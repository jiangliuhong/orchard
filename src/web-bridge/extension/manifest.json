{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Orchard Web Bridge",
  "version": "0.1.0",
  "description": "Orchard browser bridge extension",
  "permissions": ["nativeMessaging", "storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Orchard Web Bridge", "default_popup": "popup.html" }
}
